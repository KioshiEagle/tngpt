
# --- Flask ---
# Clé de signature des sessions/cookies. Génère la tienne, ex :
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-moi-en-prod
# True en local (active aussi OAUTHLIB_INSECURE_TRANSPORT pour l'OAuth en http),
# False en production.
FLASK_DEBUG=True
# Quota de questions par jour par défaut (les administrateurs n'y sont pas soumis).
DEFAULT_DAILY_QUOTA=100

# --- Base de données (obligatoire, pas de repli SQLite) ---
# Avec le docker-compose fourni : postgresql://tngpt:<POSTGRES_PASSWORD>@localhost:5432/tngpt
DATABASE_URL=postgresql://tngpt:changeme@localhost:5432/tngpt
# Mot de passe Postgres utilisé par docker-compose.yml (variable ${POSTGRES_PASSWORD})
POSTGRES_PASSWORD=changeme

# --- Authentification Google OAuth ---
# Google Cloud Console > APIs & Services > Identifiants > ID client OAuth 2.0
# Type "Application Web", URI de redirection autorisée :
#   http://localhost:8501/auth/callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# --- Groq (génération LLM) ---
# Clé de repli utilisée si le pool de clés en base (panel admin) est vide.
GROQ_API_KEY=gsk_your_api_key_here
# Modèle utilisé pour la génération des réponses du chat.
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
# Modèle utilisé pour l'extraction de métadonnées pendant l'ingestion des PDF.
GROQ_METADATA_MODEL=llama-3.1-8b-instant

# --- Qdrant (base vectorielle) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_key_if_cloud

# --- Embedding ---
GEMINI_API_KEY="clé_api_google"

# --- Ingestion Google Drive (optionnel, pipeline automatique) ---
# IDs des dossiers Drive contenant les PDF sources, séparés par des virgules.
DRIVE_FOLDER_IDS=your_folder_id_here,other_folder_id_if_any
